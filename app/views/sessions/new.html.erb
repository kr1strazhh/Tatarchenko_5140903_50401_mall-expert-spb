<main class="auth-page">
  <section class="auth-panel">
    <h1><%= t("mall_expert.auth.login_title") %></h1>

    <%= form_with url: login_path(locale: I18n.locale), class: "auth-form" do |form| %>
      <label>
        <span><%= t("mall_expert.auth.email") %></span>
        <%= form.email_field :email, required: true, autocomplete: "email" %>
      </label>

      <label>
        <span><%= t("mall_expert.auth.password") %></span>
        <%= form.password_field :password, required: true, autocomplete: "current-password" %>
      </label>

      <%= form.submit t("mall_expert.auth.login_button"), class: "primary-button" %>
    <% end %>
  </section>
</main>
