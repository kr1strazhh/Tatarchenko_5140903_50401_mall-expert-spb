<main class="auth-page">
  <section class="auth-panel">
    <h1><%= t("mall_expert.auth.signup_title") %></h1>

    <%= form_with model: @user, url: signup_path(locale: I18n.locale), class: "auth-form" do |form| %>
      <% if @user.errors.any? %>
        <div class="form-errors">
          <% @user.errors.full_messages.each do |message| %>
            <p><%= message %></p>
          <% end %>
        </div>
      <% end %>

      <label>
        <span><%= t("mall_expert.auth.email") %></span>
        <%= form.email_field :email, required: true, autocomplete: "email" %>
      </label>

      <label>
        <span><%= t("mall_expert.auth.password") %></span>
        <%= form.password_field :password, required: true, autocomplete: "new-password" %>
      </label>

      <label>
        <span><%= t("mall_expert.auth.password_confirmation") %></span>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %>
      </label>

      <%= form.submit t("mall_expert.auth.signup_button"), class: "primary-button" %>
    <% end %>
  </section>
</main>
